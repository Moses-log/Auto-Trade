# ── Alpaca ────────────────────────────────────────────────────────────────────
# Get these from https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Paper trading (default). Change to https://api.alpaca.markets for live.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Webhook security ──────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
# This value must match the "secret" field in your TradingView alert message.
WEBHOOK_SECRET=replace_me_with_a_long_random_string

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG for local dev, INFO for production
LOG_LEVEL=INFO

# ── Idempotency ───────────────────────────────────────────────────────────────
# How long (seconds) to remember an alert ID to block duplicate fires
IDEMPOTENCY_TTL=300

# ── Fractional shares (default OFF) ──────────────────────────────────────────
# Set to true only if your Alpaca account supports fractional trading
# AND the symbols you trade support fractional orders.
ALLOW_FRACTIONAL_SHARES=false

# ── Optional: Discord notifications ──────────────────────────────────────────
# Leave blank to disable. Example: https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_URL=

# ── Discord slash commands ────────────────────────────────────────────────────
# Get these from Discord Developer Portal → your app → General Information
DISCORD_APP_PUBLIC_KEY=
DISCORD_APP_ID=
# Your personal Discord user ID: Settings → Advanced → Developer Mode → right-click name → Copy User ID
DISCORD_YOUR_USER_ID=

# ── Optional: Telegram notifications ─────────────────────────────────────────
# Both values required to enable Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Robinhood ─────────────────────────────────────────────────────────────────
# Set to false to disable Robinhood entirely without removing config.
RH_ENABLED=true

# Your Robinhood login credentials.
RH_USERNAME=your@email.com
RH_PASSWORD=yourpassword

# Fraction of Robinhood buying power to use per trade.
# Example: 0.3 means 30% of available cash per BUY/ADD_LEVERAGE signal.
RH_LEVERAGE_FACTOR=0.3

# Separate Discord channel for Robinhood trade alerts.
# Falls back to DISCORD_WEBHOOK_URL if not set.
RH_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Robinhood session setup ────────────────────────────────────────────────────
# On first deploy: leave RH_ENABLED=true and deploy. The service will send a
# Discord alert asking you to POST /robinhood-auth with your SMS code.
# After that, the session token is saved to /data/robinhood.pickle and
# auto-refreshes without further SMS codes for several weeks.
#
# To re-authenticate after session expiry:
#   curl -X POST https://your-render-url/robinhood-auth \
#        -H "Content-Type: application/json" \
#        -d '{"secret":"YOUR_WEBHOOK_SECRET","sms_code":"123456"}'
